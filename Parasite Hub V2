function createScrollingSection(parent, title, createContents)
    parent:ClearAllChildren()
    
    local yOffset = 0
    
    if title then
        local titleLabel = Instance.new("TextLabel", parent)
        titleLabel.Size = UDim2.new(1, 0, 0.08, 0)
