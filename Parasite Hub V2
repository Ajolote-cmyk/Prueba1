local function getMyInfectionType()
    if player.Character then
        local infectionValue = player.Character:FindFirstChild("InfectionType")
        if infectionValue then
            if infectionValue:IsA("StringValue") then
                return infectionValue.Value
            elseif infectionValue:IsA("BoolValue") then
                return infectionValue.Value and "true" or "false"
            elseif infectionValue:IsA("NumberValue") then
                return tostring(infectionValue.Value)
            end
        end
    end
    return nil
end

local function getMyInfected()
    if player.Character then
        local infectedValue = player.Character:FindFirstChild("Infected")
        if infectedValue then
            if infectedValue:IsA("BoolValue") then
                return infectedValue.Value
            elseif infectedValue:IsA("StringValue") then
                return infectedValue.Value == "true"
            elseif infectedValue:IsA("NumberValue") then
                return infectedValue.Value > 0
            end
        end
    end
    return false
end

-- ============================
-- FUNCIONES DE MUERTE
-- ============================

local function killPlayer(humanoid)
    if not humanoid or not humanoid.Parent then return false end
    
    local success = false
    
    pcall(function()
        humanoid.Health = 0
        success = true
    end)
    
    if not success or humanoid.Health > 0 then
        task.wait(0.5)
        pcall(function()
            humanoid.Health = 0
            success = true
        end)
    end
    
    if not success or humanoid.Health > 0 then
        pcall(function()
            if player.Character then
                player.Character:BreakJoints()
                success = true
            end
        end)
    end
    
    return success
end

local function killAfterDelay(character)
    if deathActive then
        deathCancelled = true
        deathActive = false
        deathThread = nil
    end
    
    deathCancelled = false
    deathActive = true
    
    local infectionType = getMyInfectionType()
    local infected = getMyInfected()
    local team = player.Team
    
    if infectionType == "Puppeteer" or not infected or not team or team.Name ~= "Infected" then
        print("[Sistema] Muerte cancelada - No está infectado correctamente")
        deathActive = false
        return
    end
    
    print("[Sistema] Secuencia de muerte iniciada - Morirás en 2 segundos")
    
    task.spawn(function()
        for i = 1, 2 do
            if deathCancelled or not deathActive then
                print("[Sistema] Muerte cancelada")
                deathActive = false
                return
            end
            
            local currentInfection = getMyInfectionType()
            local currentInfected = getMyInfected()
            local currentTeam = player.Team
            
            if currentInfection ~= "Puppeteer" and currentInfected and currentTeam and currentTeam.Name == "Infected" then
                -- Aún está infectado, continuar
            else
                print("[Sistema] Muerte cancelada - Ya no está infectado")
                deathActive = false
                return
            end
            
            task.wait(1)
        end
        
        if deathCancelled or not deathActive then 
            deathActive = false
            return 
        end
        
        local finalInfection = getMyInfectionType()
        local finalInfected = getMyInfected()
        local finalTeam = player.Team
        
        if finalInfection == "Puppeteer" or not finalInfected or not finalTeam or finalTeam.Name ~= "Infected" then
            print("[Sistema] Muerte cancelada - Ya no está infectado")
            deathActive = false
            return
        end
        
        if player.Character and player.Character:FindFirstChild("Humanoid") then
            local humanoid = player.Character.Humanoid
            local success = killPlayer(humanoid)
            
            if success then
                print("[Sistema] Jugador eliminado")
            else
                print("[Sistema] Error al eliminar jugador")
            end
        end
        
        deathActive = false
        deathThread = nil
    end)
end

local function cancelDeath()
    if deathActive then
        deathCancelled = true
        deathActive = false
        deathThread = nil
        print("[Sistema] Muerte cancelada manualmente")
        return true
    else
        print("[Sistema] No hay secuencia de muerte activa")
        return false
    end
end

local function watchInfectionType()
    if player.Character then
        local infectionValue = player.Character:FindFirstChild("InfectionType")
        if infectionValue then
            infectionValue.Changed:Connect(function()
                local newValue = getMyInfectionType()
                if newValue == "Puppeteer" then
                    cancelDeath()
                end
            end)
        end
        
        player.Character.ChildAdded:Connect(function(child)
            if child.Name == "InfectionType" then
                task.wait(0.1)
                if getMyInfectionType() == "Puppeteer" then
                    cancelDeath()
                end
                
                child.Changed:Connect(function()
                    if getMyInfectionType() == "Puppeteer" then
                        cancelDeath()
                    end
                end)
            end
        end)
    end
end

