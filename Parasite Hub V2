-- Función para verificar si un jugador está infectado (todos los indicadores deben coincidir)
local function isInfected(character)
    if not character then return false end
    
    -- 1. Verificar InfectionType (debe tener un valor válido)
    local infectionType = character:FindFirstChild("InfectionType")
    if not infectionType then return false end
    
    local infectionValue = ""
    if infectionType:IsA("StringValue") then
        infectionValue = infectionType.Value
    elseif infectionType:IsA("BoolValue") then
        infectionValue = infectionType.Value and "true" or "false"
    elseif infectionType:IsA("NumberValue") then
        infectionValue = tostring(infectionType.Value)
    end
    
    -- Si InfectionType está vacío o es falso, no está infectado
    if infectionValue == "" or infectionValue == "false" or infectionValue == "0" or infectionValue == "None" or infectionValue == "null" then
        return false
    end
    
    -- 2. Verificar Infected (debe ser true)
    local infectedValue = character:FindFirstChild("Infected")
    if not infectedValue then return false end
    
    local infected = false
    if infectedValue:IsA("BoolValue") then
        infected = infectedValue.Value
    elseif infectedValue:IsA("StringValue") then
        infected = infectedValue.Value == "true"
    elseif infectedValue:IsA("NumberValue") then
        infected = infectedValue.Value > 0
    end
    
    if not infected then return false end
    
    -- 3. Verificar equipo (debe ser "Infected")
    local team = getPlayerTeam(character)
    if not team or team.Name ~= "Infected" then
        return false
    end
    
    -- Todos los indicadores coinciden → está infectado
    return true
end

local function getPlayerTeam(character)
    if not character then return nil end
    for _, plr in ipairs(game.Players:GetPlayers()) do
        if plr.Character == character then
            return plr.Team
        end
    end
    return nil
end

