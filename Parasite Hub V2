-- Obtener el nivel del puppet basado en AbilityStage
local function getPuppetLevelFromAbility(character)
    if not character then return 0 end
    
    -- Verificar si es un puppet
    local puppetValue = character:FindFirstChild("Puppet")
    if not puppetValue or not puppetValue:IsA("BoolValue") or puppetValue.Value ~= true then
        return 0
    end
    
    -- Buscar AbilityStage en el character
    local abilityStage = character:FindFirstChild("AbilityStage")
    if abilityStage then
        if abilityStage:IsA("NumberValue") then
            return abilityStage.Value
        elseif abilityStage:IsA("IntValue") then
            return abilityStage.Value
        elseif abilityStage:IsA("StringValue") then
            return tonumber(abilityStage.Value) or 0
        end
    end
    
    return 0
end

-- Obtener nombre de nivel basado en AbilityStage
local function getPuppetLevelName(level)
    local levelNames = {
        [1] = "Lv.1 - Puppet",
        [2] = "Lv.2 - Slash",
        [3] = "Lv.3 - Punch",
        [4] = "Lv.4 - Speed",
        [5] = "Lv.5 - Elite"
    }
    return levelNames[level] or "Lv."..level
end

local function getPuppetDisplayName(character, playerName)
    local level = getPuppetLevelFromAbility(character)
    if level > 0 then
        return "PUPPET "..getPuppetLevelName(level)..": "..playerName
    else
        return "PUPPET: "..playerName
    end
end

