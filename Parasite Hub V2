    local function updateDeathStatus()
        if deathActive then
            deathStatusLabel.Text = "Death Status: ACTIVE (2 sec)"
            deathStatusLabel.TextColor3 = Color3.fromRGB(255,0,0)
        else
            deathStatusLabel.Text = "Death Status: Not active"
            deathStatusLabel.TextColor3 = Color3.fromRGB(0,255,0)
        end
    end
    
    local function updateAbilityStage()
        if player.Character then
            local abilityStage = player.Character:FindFirstChild("AbilityStage")
            if abilityStage then
                local value = abilityStage:IsA("NumberValue") and abilityStage.Value or 
                             abilityStage:IsA("IntValue") and abilityStage.Value or
                             abilityStage:IsA("StringValue") and abilityStage.Value or "Unknown"
                abilityStageLabel.Text = "AbilityStage: "..tostring(value)
            else
                abilityStageLabel.Text = "AbilityStage: None"
            end
        else
            abilityStageLabel.Text = "AbilityStage: None"
        end
    end
    
    local function connectDeathStatus()
        spawn(function()
            while true do
                updateDeathStatus()
                task.wait(0.5)
            end
        end)
    end
    connectDeathStatus()
    
    local function connectHumanoid(humanoid)
        humanoid:GetPropertyChangedSignal("Health"):Connect(function()
            healthLabel.Text = "Health: "..math.floor(humanoid.Health)
        end)
        humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
            speedLabel.Text = "Speed: "..humanoid.WalkSpeed
        end)
        healthLabel.Text = "Health: "..math.floor(humanoid.Health)
        speedLabel.Text = "Speed: "..humanoid.WalkSpeed
    end
    
    local function updateTeamLabel()
        if player.Team then
            teamLabel.Text = "Team: "..player.Team.Name
        else
            teamLabel.Text = "Team: None"
        end
    end
    
    local function updateInfectionLabel()
        local infType = getMyInfectionType()
        if infType and infType ~= "" and infType ~= "false" and infType ~= "0" then
            infectionLabel.Text = "InfectionType: "..infType
        else
            infectionLabel.Text = "InfectionType: None"
        end
    end
    
    local function updateInfectedLabel()
        local infected = getMyInfected()
        infectedLabel.Text = "Infected: "..tostring(infected)
        infectedLabel.TextColor3 = infected and Color3.fromRGB(0,255,0) or Color3.fromRGB(255,0,0)
    end
    
    local function updatePuppetLevel()
        if player.Character then
            local level = getPuppetLevelFromAbility(player.Character)
            if level > 0 then
                puppetLevelLabel.Text = "Puppet Level: "..getPuppetLevelName(level)
            else
                puppetLevelLabel.Text = "Puppet Level: None"
            end
        end
    end
    
    updateTeamLabel()
    updateInfectionLabel()
    updateInfectedLabel()
    updatePuppetLevel()
    updateAbilityStage()
    
    -- Detectar cambios en AbilityStage del character
    local function watchAbilityStage()
        if player.Character then
            local abilityStage = player.Character:FindFirstChild("AbilityStage")
            if abilityStage then
                abilityStage.Changed:Connect(updateAbilityStage)
            end
        end
        
        player.CharacterAdded:Connect(function(char)
            task.wait(0.1)
            local abilityStage = char:FindFirstChild("AbilityStage")
            if abilityStage then
                abilityStage.Changed:Connect(updateAbilityStage)
            end
            updateAbilityStage()
        end)
    end
    watchAbilityStage()
    
    if player.Character then
        local infectionValue = player.Character:FindFirstChild("InfectionType")
        if infectionValue then
            infectionValue.Changed:Connect(updateInfectionLabel)
        end
        
        local infectedValue = player.Character:FindFirstChild("Infected")
        if infectedValue then
            infectedValue.Changed:Connect(updateInfectedLabel)
        end
        
        player.Character.ChildAdded:Connect(function(child)
            if child.Name == "InfectionType" then
                child.Changed:Connect(updateInfectionLabel)
                updateInfectionLabel()
            end
            if child.Name == "Infected" then
                child.Changed:Connect(updateInfectedLabel)
                updateInfectedLabel()
            end
            if child.Name == "Puppet" then
                task.wait(0.1)
                updatePuppetLevel()
            end
            if child.Name == "AbilityStage" then
                child.Changed:Connect(updateAbilityStage)
                updateAbilityStage()
            end
        end)
        
        local puppetValue = player.Character:FindFirstChild("Puppet")
        if puppetValue then
            puppetValue.Changed:Connect(updatePuppetLevel)
        end
    end
    
    player:GetPropertyChangedSignal("Team"):Connect(updateTeamLabel)
    
    if player.Character and player.Character:FindFirstChild("Humanoid") then
        connectHumanoid(player.Character.Humanoid)
    end
    
    player.CharacterAdded:Connect(function(char)
        local hum = char:WaitForChild("Humanoid")
        connectHumanoid(hum)
        
        task.wait(0.5)
        local infValue = char:FindFirstChild("InfectionType")
        if infValue then
            infValue.Changed:Connect(updateInfectionLabel)
        end
        local infectedValue = char:FindFirstChild("Infected")
        if infectedValue then
            infectedValue.Changed:Connect(updateInfectedLabel)
        end
        char.ChildAdded:Connect(function(child)
            if child.Name == "InfectionType" then
                child.Changed:Connect(updateInfectionLabel)
                updateInfectionLabel()
            end
            if child.Name == "Infected" then
                child.Changed:Connect(updateInfectedLabel)
                updateInfectedLabel()
            end
            if child.Name == "Puppet" then
                task.wait(0.1)
                updatePuppetLevel()
            end
            if child.Name == "AbilityStage" then
                child.Changed:Connect(updateAbilityStage)
                updateAbilityStage()
            end
        end)
        updateTeamLabel()
        updateInfectionLabel()
        updateInfectedLabel()
        updatePuppetLevel()
        updateAbilityStage()
    end)
end

